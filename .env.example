# Copy to .env and edit. Real environment variables override this file.
# .env is git-ignored; never commit it.

# Ollama server to talk to (hostname/IP, or a full http(s):// URL)
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_TIMEOUT=120

# Address and port Nonita listens on.
# 127.0.0.1 = this machine only. 0.0.0.0 = every network interface (LAN-wide).
NONITA_HOST=127.0.0.1
NONITA_PORT=7860

# Per-file attachment size limit, MB
NONITA_MAX_UPLOAD_MB=20

# Show the debug panel by default (1/true/yes)
NONITA_DEBUG=

# HTTPS certificate and key (elliptic-curve only). Create with: uv run nonita gen-cert
# NONITA_CERT=cert.pem
# NONITA_KEY=key.pem
