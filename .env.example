# Copy to .env and edit. Real environment variables override this file.
# .env is git-ignored; never commit it.

# Ollama server to talk to (hostname/IP, or a full http(s):// URL)
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_TIMEOUT=120

# Address and port Nonita listens on.
# 127.0.0.1 = this machine only. 0.0.0.0 = every network interface (LAN-wide).
NONITA_HOST=127.0.0.1
NONITA_PORT=7860

# Per-file attachment size limit, MB
NONITA_MAX_UPLOAD_MB=20

# Overwrite passes when securely deleting files (NIST SP 800-88 Rev.1 Clear: 1 is enough for modern drives)
NONITA_SHRED_PASSES=1

# Show the debug panel by default (1/true/yes)
NONITA_DEBUG=

# HTTPS is mandatory (TLS 1.3 only). If these files are missing, a self-signed elliptic-curve pair is
# generated on first start. Add names/IPs later with: uv run nonita gen-cert --force --san <name-or-ip>
# NONITA_CERT=cert.pem
# NONITA_KEY=key.pem
